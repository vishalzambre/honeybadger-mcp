{
  "mcpServers": {
    "honeybadger": {
      "command": "node",
      "args": ["/ABSOLUTE/PATH/TO/honeybadger-mcp/dist/index.js"],
      "env": {
        "HONEYBADGER_API_KEY": "YOUR_PERSONAL_AUTH_TOKEN",
        "HONEYBADGER_PROJECT_ID": "YOUR_PROJECT_ID",
        "HONEYBADGER_BASE_URL": "https://app.honeybadger.io"
      }
    }
  }
}
